# ============================================================
# デプロイ環境変数テンプレート
# 同じディレクトリに .env をコピーして値を設定してください
# （docker compose はこのディレクトリの .env を自動的に読み込みます）
# ============================================================

# --- アプリの公開URL ---
# 自分の検証サーバーのIPアドレス（または独自ドメイン）を指定してください
# 例: http://192.168.1.50:8080
NEXTAUTH_URL=http://localhost:8080
