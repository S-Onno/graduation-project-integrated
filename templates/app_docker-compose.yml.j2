# Jinja2動的テンプレートコード（改行コード：LF前提・多層パースパニック最終完全解決版）
version: '3.8'

services:
  # ----------------------------------------------------------------------------
  # 1. Nginx リバースプロキシ
  # ----------------------------------------------------------------------------
  web_server:
    image: nginx:1.25-alpine
    container_name: web_server
    ports:
      - "8080:80"
    volumes:
      - "{{ app_base_dir | default('/opt/app') }}/nginx.conf:/etc/nginx/nginx.conf:ro"
    depends_on:
      nextjs_app:
        condition: service_started
    networks:
      - app_frontend_net
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "{{ app_nginx_cpu_limit | default('1.0') }}"
          memory: "{{ app_nginx_memory_limit | default('1G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  # ----------------------------------------------------------------------------
  # 2. Next.js 15 アプリケーション（Dockerfile内製化版）
  # ----------------------------------------------------------------------------
  nextjs_app:
    build:
      context: "{{ app_base_dir | default('/opt/app') }}/nextjs_app"
      dockerfile: Dockerfile
      args:
        # 🎯 解決の核心（静的ビルドチェックの完全要塞化）：
        # パスワード部分に string | urlencode を噛ませた後、さらに | replace('$', '$$') を追加！
        # これにより Docker Compose 内部の変数置換を完全にバイパスし、Prismaビルドフェーズ中のWARNと認証エラーを根絶します。
        DATABASE_URL: 'postgresql://postgres:{{ vault_db_root_password | string | urlencode | replace("$", "$$") }}@postgres_db:5432/{{ db_name | default("app_db") }}?schema=public'
    container_name: nextjs_app
    environment:
      NODE_ENV: "production"
      PORT: "3000"
      HOSTNAME: "0.0.0.0"
      # 🎯 解決の核心（ランタイム実行時の完全同期）：
      # ランタイム起動側へも全く同じエスケープ済みのURLを流し込み、資格情報の完全開通を保証します。
      DATABASE_URL: 'postgresql://postgres:{{ vault_db_root_password | string | urlencode | replace("$", "$$") }}@postgres_db:5432/{{ db_name | default("app_db") }}?schema=public'
      NEXTAUTH_SECRET: '{{ vault_nextauth_secret | replace("$", "$$") }}'
      NEXTAUTH_URL: '{{ app_nextauth_url | default("http://10.149.245.115:8080") }}'
    depends_on:
      postgres_db:
        condition: service_healthy
    networks:
      - app_frontend_net
      - app_backend_net
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "{{ nextjs_cpu_limit | default('1.5') }}"
          memory: "{{ nextjs_memory_limit | default('1.5G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  # ----------------------------------------------------------------------------
  # 3. PostgreSQL データベース (高可用性チューニング版)
  # ----------------------------------------------------------------------------
  postgres_db:
    image: "postgres:{{ app_pg_version | default('16-alpine') }}"
    container_name: postgres_db
    environment:
      # 🎯 データベース公式コンテナ側はURL構造ではないため urlencode は不要ですが、
      # 文字列内の「$」記号を「$$」へエスケープして着弾させる必要があります。
      POSTGRES_PASSWORD: '{{ vault_db_root_password | replace("$", "$$") }}'
      POSTGRES_DB: '{{ db_name | default("app_db") }}'
    ports:
      - "5432:5432"
    command: postgres -c max_connections={{ app_pg_max_connections | default(200) }}
    networks:
      - app_backend_net
    volumes:
      - "{{ app_pg_data_path | default('/opt/app/postgres_data') }}/:/var/lib/postgresql/data:Z"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name | default('app_db') }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "{{ app_pg_cpu_limit | default('1.5') }}"
          memory: "{{ app_pg_memory_limit | default('1.5G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

networks:
  app_frontend_net:
    driver: bridge
  app_backend_net:
    driver: bridge