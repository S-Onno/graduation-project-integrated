version: '3.8'

services:
  # ----------------------------------------------------------------------------
  # 1. Nginx リバースプロキシ
  # ----------------------------------------------------------------------------
  web_server:
    image: nginx:1.25-alpine
    container_name: web_server
    ports:
      - "8080:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - nextjs_app
    networks:
      - app_frontend_net
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ----------------------------------------------------------------------------
  # 2. Next.js 15 アプリケーション
  # ----------------------------------------------------------------------------
  nextjs_app:
    build:
      context: ./nextjs_app
      dockerfile: Dockerfile
    container_name: nextjs_app
    environment:
      NODE_ENV: {{ app_env | default('production') }}
      PORT: 3000
      HOSTNAME: 0.0.0.0
      # 🔐 特殊文字対策: クォーテーションなしで定義し、内部で展開させる
      DATABASE_URL: postgresql://postgres:{{ vault_db_root_password | urlencode }}@postgres_db:5432/{{ db_name | default('app_db') }}?schema=public
      NEXTAUTH_SECRET: {{ vault_nextauth_secret }}
      NEXTAUTH_URL: {{ app_nextauth_url | default('http://10.149.245.115:8080') }}
    depends_on:
      postgres_db:
        condition: service_healthy
    # 修正: コンテナ内のフルパスを指定して確実に実行する
    command: /bin/sh -c "npx prisma db push --schema=./prisma/schema.prisma && node server.js"
    networks:
      - app_frontend_net
      - app_backend_net
    deploy:
      resources:
        limits:
          cpus: '0.50'
          memory: 512M
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ----------------------------------------------------------------------------
  # 3. PostgreSQL データベース
  # ----------------------------------------------------------------------------
  postgres_db:
    image: postgres:16-alpine
    container_name: postgres_db
    environment:
      POSTGRES_PASSWORD: '{{ vault_db_root_password }}'
      POSTGRES_DB: '{{ db_name | default('app_db') }}'
    ports:
      - "5432:5432"
    networks:
      - app_backend_net
    volumes:
      - ./postgres_db_data:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name | default('app_db') }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '1.00'
          memory: 1024M
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  app_frontend_net:
    driver: bridge
  app_backend_net:
    driver: bridge