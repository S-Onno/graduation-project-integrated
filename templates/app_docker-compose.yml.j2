# 冪等性・ハングアップ・SELinux完全対策版
---
# [infrastructure-repo-iac-secure] roles/app/templates/app_docker-compose.yml.j2
# =========================================================================
# 🎓 卒業制作：Server B アプリケーション統合マニフェスト (100同時アクセス・ハイパフォーマンス版)
# =========================================================================
version: '3.8'

networks:
  app_frontend_net:
    driver: bridge
  app_backend_net:
    driver: bridge

services:
  web_server:
    image: {{ nginx_base_image | default('nginx:1.25-alpine') }}
    container_name: web_server
    restart: unless-stopped
    ports:
      - "{{ app_web_port | default(8080) }}:80"
    volumes:
      - {{ app_base_dir | default('/opt/app') }}/nginx.conf:/etc/nginx/nginx.conf:ro,Z
    depends_on:
      nextjs_app:
        condition: service_started
    networks:
      - app_frontend_net
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  nextjs_app:
    build:
      context: {{ app_base_dir | default('/opt/app') }}/nextjs_app
      dockerfile: Dockerfile
      args:
        DATABASE_URL: 'postgresql://postgres:{{ vault_db_root_password | string | urlencode | replace("$", "$$") }}@postgres_db:5432/{{ db_name | default("app_db") }}?schema=public&connection_limit=50'
    container_name: nextjs_app
    restart: unless-stopped
    environment:
      NODE_ENV: "production"
      PORT: "3000"
      HOSTNAME: "0.0.0.0"
      # ★デバッグ核心: DB接続プール数を50枠へ拡張 ＆ Nodeスレッドプール数を64へ拡張
      DATABASE_URL: 'postgresql://postgres:{{ vault_db_root_password | string | urlencode | replace("$", "$$") }}@postgres_db:5432/{{ db_name | default("app_db") }}?schema=public&connection_limit=50'
      NEXTAUTH_SECRET: '{{ vault_nextauth_secret | replace("$", "$$") }}'
      NEXTAUTH_URL: '{{ app_nextauth_url | default("http://10.149.245.115:8080") }}'
      UV_THREADPOOL_SIZE: "64"
    depends_on:
      postgres_db:
        condition: service_healthy
    networks:
      - app_frontend_net
      - app_backend_net
    deploy:
      resources:
        limits:
          cpus: "{{ nextjs_cpu_limit | default('2.0') }}"
          memory: "{{ nextjs_memory_limit | default('2.0G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  postgres_db:
    image: "postgres:{{ app_pg_version | default('16-alpine') }}"
    container_name: postgres_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: 'postgres'
      POSTGRES_PASSWORD: '{{ vault_db_root_password | replace("$", "$$") }}'
      POSTGRES_DB: '{{ db_name | default("app_db") }}'
    ports:
      - "5432:5432"
    command: postgres -c max_connections={{ app_pg_max_connections | default(300) }} -c shared_buffers=256MB
    volumes:
      - {{ app_pg_data_path | default('/opt/app/postgres_data') }}:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name | default('app_db') }}"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 15s
    networks:
      - app_backend_net
    deploy:
      resources:
        limits:
          cpus: "{{ app_pg_cpu_limit | default('2.0') }}"
          memory: "{{ app_pg_memory_limit | default('2.0G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"