# [infrastructure-repo-iac-secure] roles/app/templates/app_nginx.conf.j2
# =========================================================================
# 🎓 卒業制作：Server B Nginx リバースプロキシ設定 (100req/s 許可 ＆ バースト120)
# =========================================================================
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections | default(2048) }};
    multi_accept on;
    use epoll;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    # 1IPあたり100r/sまでのアクセスを通過させるゾーン定義
    limit_req_zone $binary_remote_addr zone=noc_limit:10m rate={{ nginx_rate_limit_rate | default('100r/s') }};
    limit_req_status 429;

    server {
        listen 80;
        server_name _;

        location / {
            # 120件のバーストまでを即時転送（100アクセスは1件も503/429拒否・タイムアウトされない）
            limit_req zone=noc_limit burst={{ nginx_rate_limit_burst | default(120) }} nodelay;

            proxy_pass http://nextjs_app:3000/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
        }
    }
}