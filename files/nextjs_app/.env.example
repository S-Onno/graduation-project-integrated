# ============================================================
# 環境変数テンプレート
# .env にコピーして値を設定してください
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/app_db?schema=public"

# --- NextAuth.js ---
# 生成コマンド: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
