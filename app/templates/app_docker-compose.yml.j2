# 冪等性・ハングアップ・SELinux完全対策版
---
# [infrastructure-repo-iac-secure] roles/app/templates/app_docker-compose.yml.j2
# =========================================================================
# 🎓 卒業制作：Server B アプリケーション統合マニフェスト (Docker Compose V2適合版)
# =========================================================================

networks:
  app_frontend_net:
    driver: bridge
  app_backend_net:
    driver: bridge

services:
  web_server:
    image: {{ nginx_base_image | default('nginx:' + (version_image_nginx | default('1.25-alpine'))) }}
    container_name: web_server
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "{{ app_web_port | default(8080) }}:80"
    volumes:
      - {{ app_base_dir | default('/opt/app') }}/nginx.conf:/etc/nginx/nginx.conf:ro,Z
    depends_on:
      nextjs_app:
        condition: service_started
    networks:
      - app_frontend_net
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: "512M"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  nextjs_app:
    build:
      context: {{ app_base_dir | default('/opt/app') }}/nextjs_app
      dockerfile: Dockerfile
    container_name: nextjs_app
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      NODE_ENV: "production"
      PORT: "3000"
      HOSTNAME: "0.0.0.0"
      DATABASE_URL: 'postgresql://postgres:{{ vault_db_root_password | default("Pg_RoOt_sEcUrE_83d9a1f7c5e2b460") | string | urlencode | replace("$", "$$") }}@postgres_db:5432/{{ db_name | default("app_db") }}?schema=public&connection_limit=50'
      NEXTAUTH_SECRET: '{{ vault_nextauth_secret | default("NxAt_SeCrEt_sEcUrE_51d6c8b2e9a4f370") | replace("$", "$$") }}'
      NEXTAUTH_URL: '{% if app_nextauth_url is defined and app_nextauth_url %}{{ app_nextauth_url }}{% elif app_domain is defined and app_domain %}https://{{ app_domain }}{% else %}http://{{ hostvars["server-b"]["internal_ip"] | default(hostvars["server-b"]["ansible_host"] | default("10.149.245.115")) }}:{{ app_web_port | default(8080) }}{% endif %}'
      UV_THREADPOOL_SIZE: "64"
    depends_on:
      postgres_db:
        condition: service_healthy
    networks:
      - app_frontend_net
      - app_backend_net
    deploy:
      resources:
        limits:
          cpus: "{{ nextjs_cpu_limit | default('2.0') }}"
          memory: "{{ nextjs_memory_limit | default('2.0G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"

  postgres_db:
    image: "postgres:{{ version_image_postgres_app | default('16-alpine') }}"
    container_name: postgres_db
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_USER: 'postgres'
      POSTGRES_PASSWORD: '{{ vault_db_root_password | default("Pg_RoOt_sEcUrE_83d9a1f7c5e2b460") | replace("$", "$$") }}'
      POSTGRES_DB: '{{ db_name | default("app_db") }}'
    command: postgres -c max_connections={{ app_pg_max_connections | default(300) }} -c shared_buffers=256MB
    volumes:
      - {{ app_pg_data_path | default('/opt/app/postgres_data') }}:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name | default('app_db') }}"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 15s
    networks:
      - app_backend_net
    deploy:
      resources:
        limits:
          cpus: "{{ app_pg_cpu_limit | default('2.0') }}"
          memory: "{{ app_pg_memory_limit | default('2.0G') }}"
    logging:
      driver: "json-file"
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"